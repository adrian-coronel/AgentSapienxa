# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Production

# Database Connection String
# Format: Host=<hostname>;Database=<database>;Username=<username>;Password=<password>
# For PostgreSQL on same network: Host=postgres;Database=agentsapienxa;Username=postgres;Password=<your_secure_password>
CONNECTION_STRING=Host=postgres;Database=agentsapienxa;Username=postgres;Password=changeme

# OpenRouter / LLM Configuration
# Get API key from: https://openrouter.ai
OPENAI_API_KEY=your-openrouter-api-key

# Optional: OpenRouter configuration (defaults are set in docker-compose if not provided)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_INTENT_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENAI_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
OPENAI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Meta / WhatsApp Configuration
# Get these from: https://developers.facebook.com/
META_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-app-secret
META_PHONE_NUMBER_ID=your-phone-number-id
META_ACCESS_TOKEN=your-access-token
